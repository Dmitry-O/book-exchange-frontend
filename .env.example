# Local Vite dev proxies /api to VITE_API_PROXY_TARGET.
# In demo deployment CloudFront proxies /api/* to the backend.
VITE_API_BASE_URL=/api/v1
# Use "include" only when the API is cross-origin and backend CORS allows credentials.
VITE_API_CREDENTIALS=same-origin
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_DEMO_CONTACT_EMAIL=your-email@example.com
